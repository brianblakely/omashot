#!/usr/bin/env bash

set -o pipefail

APP_NAME="Omashot"
PLUGIN_ID="b.omashot"
SHELL_CONFIG_FILE="$HOME/.config/omarchy/shell.json"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omashot"
STATE_FILE="$STATE_DIR/state.json"
TMP_DIR="${TMPDIR:-/tmp}"
RECORDING_FILE="/tmp/omarchy-screenrecord-filename"
RECORDING_ESCAPE_MARKER="$STATE_DIR/recording-escape-bound"
RECORDING_CONTEXT_FILE="$STATE_DIR/recording-context.json"

COMMAND="${1:-help}"
TARGET="${2:-selection}"
CAPTURE_CONTEXT="${3:-}"
[[ -n $CAPTURE_CONTEXT ]] || CAPTURE_CONTEXT='{}'

OUTPUT_MODE="file-and-clipboard"
SAVE_LOCATION="pictures"
TIMER_SECONDS=0
INCLUDE_CURSOR="false"
SETTLE_SECONDS="0.15"
SCREENSHOT_EDITOR="tensaku-edit"
RECORDING_EDITOR="omacut"
DESKTOP_AUDIO="false"
MICROPHONE_AUDIO="false"
WEBCAM="false"
RECORD_KEYSTROKES="false"
GEOMETRY=""
SCREEN_NAME=""
CAPTURE_ACTION=""
TARGET_GEOMETRY=""
PASS_MODIFIERS=""
# A freeze handed off by the overlay remains visible through grim and becomes
# this process's responsibility to stop, including on failure.
CAPTURE_FREEZE_PID=""

fail() {
  printf '%s: %s\n' "$APP_NAME" "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "$1 is required"
}

truthy() {
  case "${1,,}" in
  1 | true | yes | on) return 0 ;;
  *) return 1 ;;
  esac
}

shell_setting_string() {
  local key="$1" fallback="$2"
  jq -r --arg key "$key" --arg fallback "$fallback" '
    if (.[$key] | type) == "string" then .[$key] else $fallback end
  ' <<<"$PLUGIN_SETTINGS"
}

shell_setting_boolean() {
  local key="$1"
  jq -r --arg key "$key" 'if .[$key] == true then "true" else "false" end' \
    <<<"$PLUGIN_SETTINGS"
}

load_shell_settings() {
  local settings='{}'
  if [[ -r $SHELL_CONFIG_FILE ]]; then
    settings=$(jq -c --arg id "$PLUGIN_ID" '
      first(.plugins[]? | select(.id == $id)) // {}
    ' "$SHELL_CONFIG_FILE" 2>/dev/null) || settings='{}'
  fi
  PLUGIN_SETTINGS="$settings"

  OUTPUT_MODE=$(shell_setting_string outputMode "$OUTPUT_MODE")
  SAVE_LOCATION=$(shell_setting_string saveLocation "$SAVE_LOCATION")
  TIMER_SECONDS=$(jq -r 'if (.timerSeconds | type) == "number" then .timerSeconds else 0 end' \
    <<<"$PLUGIN_SETTINGS")
  INCLUDE_CURSOR=$(shell_setting_boolean includeCursor)
  SCREENSHOT_EDITOR=$(shell_setting_string editorCommand "$SCREENSHOT_EDITOR")
  RECORDING_EDITOR=$(shell_setting_string recordingEditorCommand "$RECORDING_EDITOR")
  DESKTOP_AUDIO=$(shell_setting_boolean recordDesktopAudio)
  MICROPHONE_AUDIO=$(shell_setting_boolean recordMicrophoneAudio)
  WEBCAM=$(shell_setting_boolean recordWebcam)
  RECORD_KEYSTROKES=$(shell_setting_boolean recordKeystrokes)
}

capture_context_string() {
  local key="$1"
  jq -r --arg key "$key" 'if (.[$key] | type) == "string" then .[$key] else "" end' \
    <<<"$CAPTURE_CONTEXT"
}

load_capture_context() {
  (($# <= 3)) || fail "unexpected arguments; configure Omashot in $SHELL_CONFIG_FILE"
  [[ $TARGET != --* ]] || fail "options are not supported; configure Omashot in $SHELL_CONFIG_FILE"
  jq -e 'type == "object"' <<<"$CAPTURE_CONTEXT" >/dev/null 2>&1 ||
    fail "capture context must be a JSON object"

  local unknown_keys
  unknown_keys=$(jq -r 'keys - ["action", "freezePid", "geometry", "modifiers", "screenName", "targetGeometry"] | join(", ")' \
    <<<"$CAPTURE_CONTEXT")
  [[ -z $unknown_keys ]] || fail "unknown capture context: $unknown_keys"

  CAPTURE_ACTION=$(capture_context_string action)
  GEOMETRY=$(capture_context_string geometry)
  SCREEN_NAME=$(capture_context_string screenName)
  TARGET_GEOMETRY=$(capture_context_string targetGeometry)
  PASS_MODIFIERS=$(capture_context_string modifiers)
  CAPTURE_FREEZE_PID=$(jq -r '
    if .freezePid == null then "" else (.freezePid | tostring) end
  ' <<<"$CAPTURE_CONTEXT")
  [[ -z $CAPTURE_FREEZE_PID || $CAPTURE_FREEZE_PID =~ ^[1-9][0-9]*$ ]] ||
    fail "invalid freeze process id"
}

require_command jq
load_shell_settings
load_capture_context "$@"

load_user_dirs() {
  [[ -f "$HOME/.config/user-dirs.dirs" ]] && source "$HOME/.config/user-dirs.dirs"
}

normalize_output_mode() {
  local requested="${CAPTURE_ACTION:-$OUTPUT_MODE}"
  case "${requested,,}" in
  copy | clipboard) printf '%s\n' "clipboard" ;;
  save | file) printf '%s\n' "file" ;;
  edit | editor | preview) printf '%s\n' "editor" ;;
  both | file-and-clipboard | default | "") printf '%s\n' "file-and-clipboard" ;;
  *) printf '%s\n' "file-and-clipboard" ;;
  esac
}

directory_for_location() {
  load_user_dirs

  case "${SAVE_LOCATION,,}" in
  documents) printf '%s\n' "${XDG_DOCUMENTS_DIR:-$HOME/Documents}" ;;
  downloads) printf '%s\n' "${XDG_DOWNLOAD_DIR:-$HOME/Downloads}" ;;
  videos) printf '%s\n' "${XDG_VIDEOS_DIR:-$HOME/Videos}" ;;
  /*) printf '%s\n' "$SAVE_LOCATION" ;;
  *) printf '%s\n' "${XDG_PICTURES_DIR:-$HOME/Pictures}" ;;
  esac
}

recording_directory() {
  load_user_dirs

  case "${SAVE_LOCATION,,}" in
  documents) printf '%s\n' "${XDG_DOCUMENTS_DIR:-$HOME/Documents}" ;;
  downloads) printf '%s\n' "${XDG_DOWNLOAD_DIR:-$HOME/Downloads}" ;;
  /*) printf '%s\n' "$SAVE_LOCATION" ;;
  pictures | videos | *) printf '%s\n' "${XDG_VIDEOS_DIR:-$HOME/Videos}" ;;
  esac
}

safe_timer_seconds() {
  local value="${TIMER_SECONDS:-0}"
  [[ $value =~ ^[0-9]+$ ]] || value=0
  ((value < 0)) && value=0
  ((value > 60)) && value=60
  printf '%s\n' "$value"
}

wait_for_timer() {
  local seconds
  seconds=$(safe_timer_seconds)
  if ((seconds > 0)); then
    if command -v notify-send >/dev/null 2>&1; then
      notify-send "$APP_NAME" "Capturing in ${seconds}s" -t 1500 >/dev/null 2>&1 || true
    fi
    sleep "$seconds"
  fi
  sleep "$SETTLE_SECONDS"
}

JQ_MONITOR_GEO='
  def format_geo:
    .x as $x | .y as $y |
    (.width / .scale | floor) as $w |
    (.height / .scale | floor) as $h |
    .transform as $t |
    if $t == 1 or $t == 3 then
      "\($x),\($y) \($h)x\($w)"
    else
      "\($x),\($y) \($w)x\($h)"
    end;
'

focused_workspace_id() {
  hyprctl monitors -j | jq -r '.[] | select(.focused == true) | .activeWorkspace.id' | head -1
}

focused_display_geometry() {
  hyprctl monitors -j | jq -r "${JQ_MONITOR_GEO} .[] | select(.focused == true) | format_geo" | head -1
}

recording_screen_name() {
  local selected=""
  if [[ -n $SCREEN_NAME ]]; then
    selected=$(hyprctl monitors -j | jq -r --arg screen "$SCREEN_NAME" \
      'first(.[] | select(.name == $screen) | .name) // empty' 2>/dev/null)
  fi
  [[ -n $selected ]] || selected=$(hyprctl monitors -j | jq -r \
    'first(.[] | select(.focused == true) | .name) // empty' 2>/dev/null)
  printf '%s\n' "$selected"
}

display_geometry_for_screen() {
  local screen_name="$1"
  hyprctl monitors -j | jq -r --arg screen "$screen_name" "${JQ_MONITOR_GEO}
    first(.[] | select(.name == \$screen)) // empty | if . == \"\" then empty else format_geo end
  " 2>/dev/null
}

screen_name_for_geometry() {
  local geometry="$1"
  [[ $geometry =~ ^(-?[0-9]+),(-?[0-9]+)[[:space:]]([0-9]+)x([0-9]+)$ ]] || return 1

  local center_x=$((BASH_REMATCH[1] + BASH_REMATCH[3] / 2))
  local center_y=$((BASH_REMATCH[2] + BASH_REMATCH[4] / 2))
  hyprctl monitors -j | jq -r --argjson x "$center_x" --argjson y "$center_y" '
    def logical_width: if .transform == 1 or .transform == 3 then (.height / .scale) else (.width / .scale) end;
    def logical_height: if .transform == 1 or .transform == 3 then (.width / .scale) else (.height / .scale) end;
    first(.[] | select($x >= .x and $x < (.x + logical_width)
      and $y >= .y and $y < (.y + logical_height)) | .name) // empty
  ' 2>/dev/null
}

monitor_rectangles() {
  local active_workspace
  active_workspace=$(focused_workspace_id)
  hyprctl monitors -j | jq -r --arg ws "$active_workspace" "${JQ_MONITOR_GEO} .[] | select(.activeWorkspace.id == (\$ws | tonumber)) | format_geo"
}

client_rectangles() {
  local active_workspace
  active_workspace=$(focused_workspace_id)
  hyprctl clients -j | jq -r --arg ws "$active_workspace" '.[] | select(.workspace.id == ($ws | tonumber)) | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"'
}

active_window_geometry() {
  hyprctl activewindow -j | jq -r 'select(.at and .size) | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"'
}

normalize_geometry() {
  local geometry="$1"
  [[ $geometry =~ ^[[:space:]]*(-?[0-9]+),(-?[0-9]+)[[:space:]]+([0-9]+)x([0-9]+)[[:space:]]*$ ]] || return 1

  local x="${BASH_REMATCH[1]}" y="${BASH_REMATCH[2]}" width="${BASH_REMATCH[3]}" height="${BASH_REMATCH[4]}"
  ((width > 0 && height > 0)) || return 1
  printf '%s,%s %sx%s\n' "$x" "$y" "$width" "$height"
}

monitor_offset_for_screen() {
  local screen_name="$1"
  [[ -n $screen_name ]] || {
    printf '0 0\n'
    return 0
  }

  require_command hyprctl
  require_command jq

  local offset
  offset=$(hyprctl monitors -j | jq -r --arg screen "$screen_name" '.[] | select(.name == $screen) | "\(.x) \(.y)"' | head -1)
  [[ -n $offset ]] || offset="0 0"
  printf '%s\n' "$offset"
}

geometry_with_screen_offset() {
  local geometry="$1"
  geometry=$(normalize_geometry "$geometry") || return 1
  [[ $geometry =~ ^(-?[0-9]+),(-?[0-9]+)[[:space:]]([0-9]+)x([0-9]+)$ ]] || return 1

  local x="${BASH_REMATCH[1]}" y="${BASH_REMATCH[2]}" width="${BASH_REMATCH[3]}" height="${BASH_REMATCH[4]}"
  local offset ox oy
  offset=$(monitor_offset_for_screen "$SCREEN_NAME")
  read -r ox oy <<<"$offset"
  [[ $ox =~ ^-?[0-9]+$ ]] || ox=0
  [[ $oy =~ ^-?[0-9]+$ ]] || oy=0

  printf '%s,%s %sx%s\n' "$((x + ox))" "$((y + oy))" "$width" "$height"
}

all_rectangles() {
  monitor_rectangles
  client_rectangles
}

rect_contains_point() {
  local rect="$1" px="$2" py="$3"
  [[ $rect =~ ^(-?[0-9]+),(-?[0-9]+)[[:space:]]([0-9]+)x([0-9]+)$ ]] || return 1
  local rx="${BASH_REMATCH[1]}" ry="${BASH_REMATCH[2]}" rw="${BASH_REMATCH[3]}" rh="${BASH_REMATCH[4]}"
  ((px >= rx && px < rx + rw && py >= ry && py < ry + rh))
}

snap_tiny_selection() {
  local selection="$1" rects="$2"
  [[ $selection =~ ^(-?[0-9]+),(-?[0-9]+)[[:space:]]([0-9]+)x([0-9]+)$ ]] || {
    printf '%s\n' "$selection"
    return
  }

  local sx="${BASH_REMATCH[1]}" sy="${BASH_REMATCH[2]}" sw="${BASH_REMATCH[3]}" sh="${BASH_REMATCH[4]}"
  if ((sw * sh >= 20)); then
    printf '%s\n' "$selection"
    return
  fi

  while IFS= read -r rect; do
    if rect_contains_point "$rect" "$sx" "$sy"; then
      printf '%s\n' "$rect"
      return
    fi
  done <<<"$rects"

  printf '%s\n' "$selection"
}

FREEZE_PID=""
PICKED_GEOMETRY=""
NO_HW_CURSORS=""
STOP_OUTPUT_FILE=""
EDITOR_TEMP_FILE=""

start_freeze() {
  if [[ -n $CAPTURE_FREEZE_PID ]]; then
    require_capture_freeze
    return
  fi

  if command -v hyprpicker >/dev/null 2>&1; then
    hyprpicker -r -z >/dev/null 2>&1 &
    FREEZE_PID=$!
    sleep 0.1
  fi
}

require_capture_freeze() {
  [[ -z $CAPTURE_FREEZE_PID ]] || kill -0 "$CAPTURE_FREEZE_PID" 2>/dev/null ||
    fail "freeze frame is no longer available"
}

stop_freeze() {
  [[ -n $FREEZE_PID ]] && kill "$FREEZE_PID" >/dev/null 2>&1 || true
  FREEZE_PID=""
}

stop_capture_freeze() {
  [[ -n $CAPTURE_FREEZE_PID ]] && kill "$CAPTURE_FREEZE_PID" >/dev/null 2>&1 || true
  CAPTURE_FREEZE_PID=""
}

set_no_hw_cursors() {
  hyprctl eval "hl.config({ cursor = { no_hardware_cursors = $1 } })" >/dev/null 2>&1 ||
    hyprctl keyword cursor:no_hardware_cursors "$1" >/dev/null 2>&1
}

prepare_cursor_capture() {
  truthy "$INCLUDE_CURSOR" && return 0
  command -v hyprctl >/dev/null 2>&1 || return 0
  command -v jq >/dev/null 2>&1 || return 0

  NO_HW_CURSORS=$(hyprctl getoption cursor:no_hardware_cursors -j 2>/dev/null | jq -r '.int // empty' 2>/dev/null)
  [[ $NO_HW_CURSORS =~ ^-?[0-9]+$ ]] || {
    NO_HW_CURSORS=""
    return 0
  }

  set_no_hw_cursors 0
}

restore_cursor_mode() {
  [[ -n $NO_HW_CURSORS ]] || return 0
  set_no_hw_cursors "$NO_HW_CURSORS"
  NO_HW_CURSORS=""
}

cleanup() {
  stop_freeze
  stop_capture_freeze
  restore_cursor_mode
  [[ -n $EDITOR_TEMP_FILE ]] && rm -f -- "$EDITOR_TEMP_FILE"
  [[ -n $STOP_OUTPUT_FILE ]] && rm -f -- "$STOP_OUTPUT_FILE"
}

trap cleanup EXIT

last_state_value() {
  local key="$1"
  [[ -f "$STATE_FILE" ]] || return 0
  jq -r --arg key "$key" '.[$key] // empty' "$STATE_FILE" 2>/dev/null
}

write_state() {
  mkdir -p "$STATE_DIR" 2>/dev/null || true

  local selection="${1:-}" screenshot="${2:-}" recording="${3:-}"
  local current='{}'
  [[ -f "$STATE_FILE" ]] && current=$(cat "$STATE_FILE" 2>/dev/null || printf '{}')

  jq -n \
    --argjson current "$current" \
    --arg selection "$selection" \
    --arg screenshot "$screenshot" \
    --arg recording "$recording" \
    --arg updatedAt "$(date -Iseconds)" '
      $current
      + (if $selection != "" then {lastSelection: $selection} else {} end)
      + (if $screenshot != "" then {lastScreenshot: $screenshot} else {} end)
      + (if $recording != "" then {lastRecording: $recording} else {} end)
      + {updatedAt: $updatedAt}
    ' >"$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"
}

write_recording_context() {
  local geometry="$1" screen_name="$2"
  geometry=$(normalize_geometry "$geometry") || return 1

  mkdir -p "$STATE_DIR" 2>/dev/null || return 1
  jq -n \
    --arg geometry "$geometry" \
    --arg screenName "$screen_name" \
    '{geometry:$geometry,screenName:$screenName}' \
    >"$RECORDING_CONTEXT_FILE.tmp" && mv "$RECORDING_CONTEXT_FILE.tmp" "$RECORDING_CONTEXT_FILE"
}

clear_recording_context() {
  rm -f -- "$RECORDING_CONTEXT_FILE" "$RECORDING_CONTEXT_FILE.tmp"
}

recording_context_value() {
  local key="$1"
  [[ -r $RECORDING_CONTEXT_FILE ]] || return 0
  jq -r --arg key "$key" 'if (.[$key] | type) == "string" then .[$key] else "" end' \
    "$RECORDING_CONTEXT_FILE" 2>/dev/null
}

pick_geometry() {
  local rects selection
  PICKED_GEOMETRY=""

  if [[ -n $GEOMETRY ]]; then
    PICKED_GEOMETRY=$(geometry_with_screen_offset "$GEOMETRY") || return 1
    return
  fi

  require_command hyprctl
  require_command jq

  case "${TARGET,,}" in
  screen | all | all-screens)
    ;;
  display | monitor | fullscreen)
    PICKED_GEOMETRY=$(focused_display_geometry)
    ;;
  active-window | active)
    PICKED_GEOMETRY=$(active_window_geometry)
    ;;
  window | windows)
    require_command slurp
    rects=$(client_rectangles)
    [[ -n $rects ]] || rects=$(all_rectangles)
    start_freeze
    selection=$(printf '%s\n' "$rects" | slurp -r 2>/dev/null)
    PICKED_GEOMETRY=$selection
    ;;
  last | last-selection)
    PICKED_GEOMETRY=$(last_state_value lastSelection)
    ;;
  smart)
    require_command slurp
    rects=$(all_rectangles)
    start_freeze
    selection=$(printf '%s\n' "$rects" | slurp 2>/dev/null)
    PICKED_GEOMETRY=$(snap_tiny_selection "$selection" "$rects")
    ;;
  selection | region | *)
    require_command slurp
    start_freeze
    selection=$(slurp 2>/dev/null)
    PICKED_GEOMETRY=$selection
    ;;
  esac
}

open_editor() {
  local file="$1"
  [[ -f $file ]] || return 1

  if [[ -n $SCREENSHOT_EDITOR ]]; then
    if [[ $SCREENSHOT_EDITOR == *" "* ]]; then
      (
        bash -lc "$SCREENSHOT_EDITOR \"\$1\"" _ "$file"
        rm -f -- "$file"
      ) >/dev/null 2>&1 &
      return 0
    fi
    if command -v "$SCREENSHOT_EDITOR" >/dev/null 2>&1; then
      (
        "$SCREENSHOT_EDITOR" "$file"
        rm -f -- "$file"
      ) >/dev/null 2>&1 &
      return 0
    fi
  fi

  if command -v xdg-open >/dev/null 2>&1; then
    (
      xdg-open "$file"
      rm -f -- "$file"
    ) >/dev/null 2>&1 &
    return 0
  fi

  return 1
}

notify_capture() {
  local title="$1" body="$2"

  if command -v notify-send >/dev/null 2>&1; then
    notify-send "$title" "$body" -t 3000 >/dev/null 2>&1 || true
  fi
}

demo_screenshot() {
  require_command grim

  local output_dir filename filepath
  output_dir=$(directory_for_location)
  mkdir -p "$output_dir"
  filename="omashot-demo-$(date +'%Y-%m-%d_%H-%M-%S').png"
  filepath="$output_dir/$filename"

  local grim_args=()
  truthy "$INCLUDE_CURSOR" && grim_args+=(-c)

  prepare_cursor_capture
  if ! grim "${grim_args[@]}" "$filepath"; then
    restore_cursor_mode
    return 1
  fi
  restore_cursor_mode

  printf '%s\n' "$filepath"
  notify_capture "Omashot demo screenshot saved" "$filepath"
}

screenshot() {
  require_command grim
  require_command jq
  require_capture_freeze

  local mode filepath output_dir filename selection
  mode=$(normalize_output_mode)

  if [[ $mode == "clipboard" || $mode == "file-and-clipboard" ]]; then
    require_command wl-copy
  fi

  wait_for_timer
  pick_geometry || exit $?
  selection=$PICKED_GEOMETRY
  if [[ -z $selection && ! ${TARGET,,} =~ ^(screen|all|all-screens)$ ]]; then
    exit 0
  fi

  if [[ -n $selection ]]; then
    write_state "$selection" "" ""
  fi

  if [[ $mode == "editor" ]]; then
    filepath=$(mktemp "$TMP_DIR/omashot-editor.XXXXXX.png") ||
      fail "could not create temporary editor image"
    EDITOR_TEMP_FILE="$filepath"
  elif [[ $mode != "clipboard" ]]; then
    output_dir=$(directory_for_location)
    mkdir -p "$output_dir"
    filename="screenshot-$(date +'%Y-%m-%d_%H-%M-%S').png"
    filepath="$output_dir/$filename"
  fi

  local grim_args=()
  [[ -n $selection ]] && grim_args+=(-g "$selection")
  truthy "$INCLUDE_CURSOR" && grim_args+=(-c)

  require_capture_freeze
  prepare_cursor_capture
  if [[ $mode == "clipboard" ]]; then
    grim "${grim_args[@]}" - | wl-copy --type image/png || exit 1
  else
    grim "${grim_args[@]}" "$filepath" || exit 1
  fi
  stop_freeze
  stop_capture_freeze
  restore_cursor_mode

  case "$mode" in
  clipboard)
    notify_capture "Screenshot copied" "Image is on the clipboard."
    ;;
  file)
    printf '%s\n' "$filepath"
    write_state "" "$filepath" ""
    notify_capture "Screenshot saved" "$filepath"
    ;;
  editor)
    if ! open_editor "$filepath"; then
      rm -f -- "$filepath"
      EDITOR_TEMP_FILE=""
      fail "no screenshot editor is available"
    fi
    EDITOR_TEMP_FILE=""
    notify_capture "Screenshot opened" "Temporary image opened in editor."
    ;;
  file-and-clipboard | *)
    wl-copy --type image/png <"$filepath"
    printf '%s\n' "$filepath"
    write_state "" "$filepath" ""
    notify_capture "Screenshot saved to file and clipboard" "$filepath"
    ;;
  esac
}

recording_active() {
  pgrep -f "^gpu-screen-recorder" >/dev/null 2>&1
}

publish_recording_filename() {
  local filename="$1" marker_tmp

  # The Omarchy recorder expects this fixed marker path.  Never redirect into
  # it directly: another local user could pre-place a symlink and make the
  # redirect truncate its target.  Build a private file beside the marker and
  # atomically replace the directory entry instead.
  marker_tmp=$(mktemp -- "${RECORDING_FILE}.XXXXXX") || return 1
  if ! printf '%s\n' "$filename" >"$marker_tmp" ||
    ! mv -fT -- "$marker_tmp" "$RECORDING_FILE"; then
    rm -f -- "$marker_tmp"
    return 1
  fi
}

install_recording_escape_binding() {
  command -v hyprctl >/dev/null 2>&1 || return 0
  mkdir -p "$STATE_DIR" 2>/dev/null || return 0

  local lua
  lua='
    local function disable_bindings(bindings)
      if not bindings then return end
      for _, binding in ipairs(bindings) do binding:set_enabled(false) end
    end

    local function bindings_are_live(bindings, expected_count)
      if not bindings or #bindings ~= expected_count then return false end
      for _, binding in ipairs(bindings) do
        if binding:is_enabled() == nil then return false end
      end
      return true
    end

    if omashot_recording_keybinds then
      disable_bindings(omashot_recording_keybinds)
      omashot_recording_keybinds = nil
    end
    if omashot_recording_escape_bind then
      omashot_recording_escape_bind:set_enabled(false)
      omashot_recording_escape_bind = nil
    end
    if omashot_recording_modifier_tracker then
      local tracker = omashot_recording_modifier_tracker
      if tracker.timer then tracker.timer:set_enabled(false) end
      if tracker.subscription and tracker.subscription:is_active() then
        tracker.subscription:remove()
      end
      omashot_recording_modifier_tracker = nil
    end

    omashot_recording_binding_sets = omashot_recording_binding_sets or {}
    for _, bindings in pairs(omashot_recording_binding_sets) do
      disable_bindings(bindings)
    end

    local bindings = omashot_recording_binding_sets.immediate
    if not bindings_are_live(bindings, 1) then
      bindings = {}
      omashot_recording_binding_sets.immediate = bindings
      table.insert(bindings,
        hl.bind("ESCAPE", hl.dsp.exec_cmd("omarchy-shell b.omashot stopRecording"), {
          description = "Stop Omashot recording",
          locked = false,
          dont_inhibit = false,
          allow_input_capture = false,
        }))
    end

    for _, binding in ipairs(bindings) do binding:set_enabled(true) end
  '
  if hyprctl eval "$lua" >/dev/null 2>&1; then
    printf 'immediate\n' >"$RECORDING_ESCAPE_MARKER"
  else
    : >"$RECORDING_ESCAPE_MARKER"
    remove_recording_escape_binding
    return 1
  fi
}

install_recording_keystroke_bindings() {
  command -v hyprctl >/dev/null 2>&1 || return 0
  mkdir -p "$STATE_DIR" 2>/dev/null || return 0

  local lua
  read -r -d '' lua <<'LUA' || true
if omashot_recording_keybinds then
  for _, binding in ipairs(omashot_recording_keybinds) do binding:set_enabled(false) end
  omashot_recording_keybinds = nil
end
if omashot_recording_escape_bind then
  omashot_recording_escape_bind:set_enabled(false)
  omashot_recording_escape_bind = nil
end
if omashot_recording_modifier_tracker then
  local tracker = omashot_recording_modifier_tracker
  if tracker.timer then tracker.timer:set_enabled(false) end
  if tracker.subscription and tracker.subscription:is_active() then
    tracker.subscription:remove()
  end
  omashot_recording_modifier_tracker = nil
end

local function disable_bindings(bindings)
  if not bindings then return end
  for _, binding in ipairs(bindings) do binding:set_enabled(false) end
end

local function bindings_are_live(bindings, expected_count)
  if not bindings or #bindings ~= expected_count then return false end
  for _, binding in ipairs(bindings) do
    if binding:is_enabled() == nil then return false end
  end
  return true
end

omashot_recording_binding_sets = omashot_recording_binding_sets or {}
for _, bindings in pairs(omashot_recording_binding_sets) do
  disable_bindings(bindings)
end

