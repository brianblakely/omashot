-- Each global binding carries both press and release protocol states. Modifier
-- state is also reconciled against Hyprland's physical-key state below because
-- a Lua-wrapped global shortcut can otherwise leave modifiers pressed forever.
local function add_global_binding(bindings, entry, description, repeating, non_consuming)
  local endpoint = "b.omashot:" .. entry[2]
  local press_options = {
    description = description,
    non_consuming = true,
    ignore_mods = true,
    locked = false,
    dont_inhibit = false,
    allow_input_capture = false,
  }
  if repeating then press_options.repeating = true end
  if not non_consuming then press_options.non_consuming = false end

  -- Hyprland's global dispatcher mirrors both physical states through the
  -- protocol. A second release=true global binding also fires on key-down and
  -- would make every single press appear as a ×2 repeat.
  table.insert(bindings, hl.bind(entry[1], hl.dsp.global(endpoint), press_options))
end

local bindings = omashot_recording_binding_sets.keystrokes
local expected_binding_count = #ordinary + #modifiers + 1
if not bindings_are_live(bindings, expected_binding_count) then
  bindings = {}
  omashot_recording_binding_sets.keystrokes = bindings
  for _, entry in ipairs(ordinary) do
    add_global_binding(bindings, entry, "Show key in Omashot recording", true, true)
  end
  for _, entry in ipairs(modifiers) do
    add_global_binding(bindings, entry, "Track modifier in Omashot recording", false, true)
  end
  add_global_binding(bindings, { "ESCAPE", "key-escape" },
    "Hold Escape to stop Omashot recording", false, false)
end

for _, binding in ipairs(bindings) do binding:set_enabled(true) end

-- Raw keyboard events are emitted immediately before Hyprland updates its
-- pressed-key set. Reconcile one event-loop tick later, then send only physical
-- modifier state changes over Hyprland's existing custom-event IPC socket.
if hl.on and hl.timer and hl.is_key_down and hl.dsp and hl.dsp.event then
  local tracker = { states = {} }
  for _, entry in ipairs(modifiers) do
    tracker.states[entry[2]] = false
    entry[3] = hl.dsp.event("b.omashot-modifier," .. entry[2] .. ",1")
    entry[4] = hl.dsp.event("b.omashot-modifier," .. entry[2] .. ",0")
  end

  local function reconcile_modifiers()
    for _, entry in ipairs(modifiers) do
      local pressed = hl.is_key_down(entry[1])
      if tracker.states[entry[2]] ~= pressed then
        tracker.states[entry[2]] = pressed
        if pressed then hl.dispatch(entry[3]) else hl.dispatch(entry[4]) end
      end
    end
    if tracker.timer then tracker.timer:set_enabled(false) end
  end

  tracker.timer = hl.timer(reconcile_modifiers, { timeout = 1, type = "repeat" })
  tracker.timer:set_enabled(false)
  tracker.subscription = hl.on("input.keyboard.key", function()
    tracker.timer:set_enabled(true)
  end)
  omashot_recording_modifier_tracker = tracker
  tracker.timer:set_enabled(true)
end
LUA

  if hyprctl eval "$lua" >/dev/null 2>&1; then
    printf 'keystrokes\n' >"$RECORDING_ESCAPE_MARKER"
  else
    : >"$RECORDING_ESCAPE_MARKER"
    remove_recording_escape_binding
    return 1
  fi
}

remove_recording_escape_binding() {
  [[ -e $RECORDING_ESCAPE_MARKER ]] || return 0

  if command -v hyprctl >/dev/null 2>&1; then
    hyprctl eval '
      -- Lua handle unbinds match by key and modifier rather than by identity.
      -- Disable our retained handles so unrelated user bindings stay intact.
      if omashot_recording_keybinds then
        for _, binding in ipairs(omashot_recording_keybinds) do binding:set_enabled(false) end
        omashot_recording_keybinds = nil
      end
      if omashot_recording_escape_bind then
        omashot_recording_escape_bind:set_enabled(false)
        omashot_recording_escape_bind = nil
      end
      if omashot_recording_modifier_tracker then
        local tracker = omashot_recording_modifier_tracker
        if tracker.timer then tracker.timer:set_enabled(false) end
        if tracker.subscription and tracker.subscription:is_active() then
          tracker.subscription:remove()
        end
        omashot_recording_modifier_tracker = nil
      end
      if omashot_recording_binding_sets then
        for _, bindings in pairs(omashot_recording_binding_sets) do
          for _, binding in ipairs(bindings) do binding:set_enabled(false) end
        end
      end
    ' >/dev/null 2>&1 || return 0
  fi
  rm -f -- "$RECORDING_ESCAPE_MARKER"
}

recording_session_locked() {
  if command -v omarchy-hyprland-session-locked >/dev/null 2>&1; then
    omarchy-hyprland-session-locked >/dev/null 2>&1
    return $?
  fi

  hyprctl monitors -j 2>/dev/null | jq -e \
    'any(.[]; (.solitaryBlockedBy // []) | index("LOCK"))' >/dev/null 2>&1
}

sync_recording_bindings() {
  if ! recording_active || recording_session_locked; then
    remove_recording_escape_binding
    return 0
  fi

  local desired="immediate" current=""
  truthy "$RECORD_KEYSTROKES" && desired="keystrokes"
  [[ -r $RECORDING_ESCAPE_MARKER ]] && current=$(<"$RECORDING_ESCAPE_MARKER")
  [[ $current == "$desired" ]] && return 0

  remove_recording_escape_binding
  if [[ $desired == "keystrokes" ]]; then
    install_recording_keystroke_bindings
  else
    install_recording_escape_binding
  fi
}

cleanup_webcam() {
  pkill -f "WebcamOverlay" 2>/dev/null || true
}

start_webcam_overlay() {
  cleanup_webcam

  local webcam_device capture_options available_formats resolution
  webcam_device=$(v4l2-ctl --list-devices 2>/dev/null | grep -m1 "^[[:space:]]*/dev/video" | tr -d '\t')
  if [[ -z $webcam_device ]]; then
    notify_capture "No webcam devices found" "Recording will start without webcam."
    return 1
  fi

  capture_options="framerate=30"
  available_formats=$(v4l2-ctl --list-formats-ext -d "$webcam_device" 2>/dev/null)
  for resolution in 640x360 1280x720 1920x1080; do
    if grep -q "$resolution" <<<"$available_formats"; then
      capture_options="video_size=$resolution,$capture_options"
      break
    fi
  done

  mpv "av://v4l2:$webcam_device" \
    --profile=low-latency --untimed --no-cache \
    --demuxer-lavf-o="$capture_options" \
    '--vf=lavfi=[crop=ih*8/9:ih]' \
    --title="WebcamOverlay" --wayland-app-id="WebcamOverlay-medium" \
    --no-border --no-audio --no-osc --osd-level=0 \
    --really-quiet >/dev/null 2>&1 &
  sleep 1
}

geometry_to_gsr_region() {
  local geometry="$1"
  [[ $geometry =~ ^(-?[0-9]+),(-?[0-9]+)[[:space:]]([0-9]+)x([0-9]+)$ ]] || return 1
  printf '%sx%s+%s+%s\n' "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}" "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
}

refresh_recording_indicator() {
  if command -v omarchy-shell >/dev/null 2>&1; then
    omarchy-shell -q omarchy.indicators refresh >/dev/null 2>&1 || true
  fi
}

open_recording_in_omacut() {
  local file="$1"
  [[ -f $file && -s $file ]] || return 0
  local editor="${RECORDING_EDITOR:-omacut}"
  # Support full command with args (e.g. "omaroll --flag")
  if [[ "$editor" == *" "* ]]; then
    ( bash -lc "$editor \"\$1\"" _ "$file" ) >/dev/null 2>&1 &
    return 0
  fi
  if command -v "$editor" >/dev/null 2>&1; then
    if command -v setsid >/dev/null 2>&1 && command -v uwsm-app >/dev/null 2>&1; then
      setsid uwsm-app -- "$editor" "$file" </dev/null >/dev/null 2>&1 &
    else
      "$editor" "$file" </dev/null >/dev/null 2>&1 &
    fi
    return 0
  fi
  # Fallback to omacut if custom editor not found
  if [[ "$editor" != "omacut" ]] && command -v omacut >/dev/null 2>&1; then
    if command -v setsid >/dev/null 2>&1 && command -v uwsm-app >/dev/null 2>&1; then
      setsid uwsm-app -- omacut "$file" </dev/null >/dev/null 2>&1 &
    else
      omacut "$file" </dev/null >/dev/null 2>&1 &
    fi
    return 0
  fi
  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$file" >/dev/null 2>&1 &
  fi
}

record_geometry() {
  if ! recording_active; then
    remove_recording_escape_binding
    clear_recording_context
  fi
  require_command gpu-screen-recorder

  local output_dir selection region filename audio_devices target_screen
  output_dir=$(recording_directory)
  mkdir -p "$output_dir"

  wait_for_timer

  pick_geometry || exit $?
  selection=$PICKED_GEOMETRY
  stop_freeze
  stop_capture_freeze
  [[ -n $selection ]] || exit 0
  region=$(geometry_to_gsr_region "$selection") || exit 1

  filename="$output_dir/screenrecording-$(date +'%Y-%m-%d_%H-%M-%S').mp4"
  audio_devices=""

  truthy "$DESKTOP_AUDIO" && audio_devices+="default_output"
  if truthy "$MICROPHONE_AUDIO"; then
    [[ -n $audio_devices ]] && audio_devices+="|"
    audio_devices+="default_input"
  fi

  local args=(-w "$region" -k auto -f 60 -fm cfr -fallback-cpu-encoding yes -o "$filename")
  [[ -n $audio_devices ]] && args+=(-a "$audio_devices" -ac aac)

  truthy "$WEBCAM" && start_webcam_overlay

  gpu-screen-recorder "${args[@]}" >/dev/null 2>&1 &
  local pid=$!

  while kill -0 "$pid" 2>/dev/null && [[ ! -f $filename ]]; do
    sleep 0.2
  done

  if kill -0 "$pid" 2>/dev/null; then
    if ! publish_recording_filename "$filename"; then
      kill -INT "$pid" 2>/dev/null || true
      clear_recording_context
      remove_recording_escape_binding
      fail "could not publish the recording filename"
    fi
    write_state "" "" "$filename"
    target_screen="$SCREEN_NAME"
    [[ -n $target_screen ]] || target_screen=$(screen_name_for_geometry "$selection")
    write_recording_context "$selection" "$target_screen" || true
    refresh_recording_indicator
    sync_recording_bindings
  else
    clear_recording_context
    remove_recording_escape_binding
  fi
}

record_screen() {
  if [[ -n $GEOMETRY ]]; then
    record_geometry
    return
  fi

  if ! recording_active; then
    remove_recording_escape_binding
    clear_recording_context
  fi
  require_command omarchy-capture-screenrecording

  local output_dir target_screen target_geometry
  output_dir=$(recording_directory)
  mkdir -p "$output_dir"

  wait_for_timer

  if [[ -n $SCREEN_NAME ]] && command -v hyprctl >/dev/null 2>&1; then
    hyprctl dispatch focusmonitor "$SCREEN_NAME" >/dev/null 2>&1 || true
  fi
  target_screen=$(recording_screen_name)
  if [[ -n $TARGET_GEOMETRY && -n $SCREEN_NAME ]]; then
    target_geometry=$(geometry_with_screen_offset "$TARGET_GEOMETRY") || target_geometry=""
  fi
  [[ -n $target_geometry ]] || target_geometry=$(display_geometry_for_screen "$target_screen")
  [[ -n $target_geometry ]] || target_geometry=$(focused_display_geometry)

  local args=()
  case "${TARGET,,}" in
  screen | display | monitor | fullscreen | all | all-screens)
    args+=(--fullscreen)
    ;;
  esac

  truthy "$DESKTOP_AUDIO" && args+=(--with-desktop-audio)
  truthy "$MICROPHONE_AUDIO" && args+=(--with-microphone-audio)
  truthy "$WEBCAM" && args+=(--with-webcam)

  OMARCHY_SCREENRECORD_DIR="$output_dir" omarchy-capture-screenrecording "${args[@]}"
  local status=$?
  if ((status == 0)) && recording_active; then
    [[ -n $target_geometry ]] && write_recording_context "$target_geometry" "$target_screen" || true
    sync_recording_bindings
  else
    clear_recording_context
    remove_recording_escape_binding
  fi
  return "$status"
}

stop_recording() {
  remove_recording_escape_binding
  require_command omarchy-capture-screenrecording
  local filename status
  filename=$(cat "$RECORDING_FILE" 2>/dev/null)
  STOP_OUTPUT_FILE=$(mktemp "$TMP_DIR/omashot-stop.XXXXXX") ||
    fail "could not create temporary stop output"

  omarchy-capture-screenrecording --stop-recording >"$STOP_OUTPUT_FILE"
  status=$?
  cat "$STOP_OUTPUT_FILE"

  if ((status == 0)) &&
    [[ -n $filename && -f $filename && -s $filename ]] &&
    grep -Fqx -- "$filename" "$STOP_OUTPUT_FILE"; then
    write_state "" "" "$filename"
    open_recording_in_omacut "$filename"
  fi

  rm -f -- "$STOP_OUTPUT_FILE"
  STOP_OUTPUT_FILE=""
  if recording_active; then
    sync_recording_bindings
  else
    clear_recording_context
  fi
  return "$status"
}

pass_escape() {
  command -v hyprctl >/dev/null 2>&1 || return 0

  local modifiers
  case "$PASS_MODIFIERS" in
  "" | CTRL | SHIFT | ALT | SUPER | "CTRL + SHIFT" | "CTRL + ALT" | "CTRL + SUPER" | "SHIFT + ALT" | "SHIFT + SUPER" | "ALT + SUPER" | "CTRL + SHIFT + ALT" | "CTRL + SHIFT + SUPER" | "CTRL + ALT + SUPER" | "SHIFT + ALT + SUPER" | "CTRL + SHIFT + ALT + SUPER") modifiers="$PASS_MODIFIERS" ;;
  *) return 1 ;;
  esac

  hyprctl eval "
    local target = hl.get_active_window()
    if target then
      hl.dispatch(hl.dsp.send_key_state({ state = \"down\", mods = \"$modifiers\", key = \"ESCAPE\", window = target }))
      hl.dispatch(hl.dsp.send_key_state({ state = \"up\", mods = \"$modifiers\", key = \"ESCAPE\", window = target }))
    end
  " >/dev/null 2>&1
}

status_json() {
  local is_recording="false"
  if recording_active; then
    is_recording="true"
    if [[ ! -s $RECORDING_CONTEXT_FILE ]]; then
      local target_screen target_geometry
      target_screen=$(recording_screen_name)
      target_geometry=$(display_geometry_for_screen "$target_screen")
      [[ -n $target_geometry ]] || target_geometry=$(focused_display_geometry)
      [[ -n $target_geometry ]] && write_recording_context "$target_geometry" "$target_screen" || true
    fi
    sync_recording_bindings
  else
    remove_recording_escape_binding
    clear_recording_context
  fi

  mkdir -p "$STATE_DIR" 2>/dev/null || true
  jq -n \
    --argjson recording "$is_recording" \
    --argjson recordKeystrokes "$RECORD_KEYSTROKES" \
    --arg recordingGeometry "$(recording_context_value geometry)" \
    --arg recordingScreenName "$(recording_context_value screenName)" \
    --arg lastSelection "$(last_state_value lastSelection)" \
    --arg lastScreenshot "$(last_state_value lastScreenshot)" \
    --arg lastRecording "$(last_state_value lastRecording)" \
    '{recording:$recording,recordKeystrokes:$recordKeystrokes,
      recordingGeometry:$recordingGeometry,recordingScreenName:$recordingScreenName,
      lastSelection:$lastSelection,lastScreenshot:$lastScreenshot,lastRecording:$lastRecording}'
}

open_last() {
  local file
  file=$(last_state_value lastScreenshot)
  [[ -f $file ]] || file=$(last_state_value lastRecording)
  [[ -f $file ]] || exit 1

  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$file" >/dev/null 2>&1 &
  else
    printf '%s\n' "$file"
  fi
}

